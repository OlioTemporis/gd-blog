---
import BaseLayout from '../layouts/BaseLayout.astro';
const allPosts = Object.values(import.meta.glob('./equinox/*.md', { eager: true }));
const pageTitle = "Equinox";
---

<BaseLayout title={pageTitle}>
		<h1 class="text-4xl font-bold py-4 mt-6">{pageTitle}</h1>
		<p>Welcome to the Equinox repository.</p>
		<ul>
            {allPosts.map((post: any) => <li><a href={post.url}>{post.frontmatter.title}</a></li>)}
  		</ul>
</BaseLayout>